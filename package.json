{
  "name": "ts-universal-fullstack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "turbo dev --filter @starter/web",
    "dev:all": "turbo dev",
    "web": "pnpm --filter @starter/web dev",
    "web:direct": "pnpm --filter @starter/web dev:app",
    "native": "pnpm --filter @starter/mobile dev",
    "ios": "pnpm --filter @starter/mobile ios",
    "android": "pnpm --filter @starter/mobile android",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo test",
    "doctor": "pnpm --filter @starter/scripts doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "25.7.0",
    "portless": "0.13.0",
    "tsx": "4.21.0",
    "turbo": "2.9.12",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
